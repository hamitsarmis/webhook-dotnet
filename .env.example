# Copy to `.env` in this directory and override any value you don't want
# the published default for. docker-compose.yml falls back to these defaults
# when the corresponding variable is not set.

POSTGRES_DB=webhookfx
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Shared secret between WebhookFx and the MCP server (header X-Internal-Key).
# Empty = the internal path is closed and the MCP server cannot place orders.
# At least 32 characters. Generate with: openssl rand -hex 32
WEBHOOKFX_INTERNAL_KEY=

# Host port for Postgres when docker-compose.mcp.yml is used (loopback only).
MCP_POSTGRES_PORT=5432
